{
  "name": "my-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run dev:desktop",
    "dev:cli": "vp run --filter ./apps/cli dev",
    "dev:desktop": "vp run --filter ./apps/desktop dev",
    "build:cli": "vp run --filter ./apps/cli build",
    "build:desktop": "vp run --filter ./apps/desktop build",
    "content:build": "cargo run -p vesper-cli -- build",
    "content:publish": "cargo run -p vesper-cli -- publish",
    "content:publish:live": "cargo run -p vesper-cli -- publish --live",
    "cli:install": "cargo install --path apps/cli --locked",
    "cli:uninstall": "cargo uninstall vesper",
    "lint": "pnpm run lint:frontend && pnpm run lint:rust",
    "lint:frontend": "vp lint",
    "lint:rust": "cargo clippy --workspace --all-targets --all-features -- -D warnings",
    "lint:fix": "vp lint --fix",
    "format": "vp fmt && cargo fmt --all",
    "format:check": "pnpm run format:check:frontend && pnpm run format:check:rust",
    "format:check:frontend": "vp fmt --check",
    "format:check:rust": "cargo fmt --all -- --check",
    "check": "pnpm run check:frontend && pnpm run check:rust",
    "check:frontend": "vp run --filter \"./apps/**\" --filter \"./packages/**\" check",
    "check:rust": "cargo check --workspace --all-targets",
    "test": "pnpm run test:frontend && pnpm run test:rust",
    "test:frontend": "vp test --run",
    "test:rust": "cargo test --workspace --all-targets",
    "precommit": "pnpm run check && pnpm run test",
    "precommit:fix": "pnpm run format && pnpm run lint:fix"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "simple-git-hooks": "2.13.1",
    "typescript": "6.0.3",
    "vite-plus": "0.3.0"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm run precommit"
  },
  "packageManager": "pnpm@11.22.0"
}
