    "@tiptap/starter-kit": "3.31.3",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "thumbhash": "0.1.1"
  },
  "devDependencies": {
    "@my-workspace/tsconfig": "workspace:*",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
