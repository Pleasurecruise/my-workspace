{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vesper",
  "version": "0.1.6",
  "identifier": "me.you-find.vesper",
  "build": {
    "beforeDevCommand": "pnpm frontend:dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm frontend:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Vesper",
        "width": 1100,
        "height": 760,
        "minWidth": 720,
        "minHeight": 520,
        "center": true,
        "resizable": true,
        "dragDropEnabled": false,
        "titleBarStyle": "Visible",
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "macOS": {
      "signingIdentity": "-"
    },
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUzQUFEMjJFMzE2MThCMDUKUldRRmkyRXhMdEtxVXlTMTdlQzNrZjVoYTk2T2FlS0hwOVdwaDhuNk5aME1hN3kyUTBDTDJmYlYK",
      "endpoints": [
        "https://github.com/Pleasurecruise/my-workspace/releases/latest/download/latest.json"
      ]
    }
  }
}
