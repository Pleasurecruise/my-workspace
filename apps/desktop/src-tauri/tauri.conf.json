{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vesper",
  "version": "0.1.0",
  "identifier": "me.you-find.vesper",
  "build": {
    "beforeDevCommand": "pnpm frontend:dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm frontend:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Vesper",
        "width": 1100,
        "height": 760,
        "minWidth": 720,
        "minHeight": 520,
        "center": true,
        "resizable": true,
        "titleBarStyle": "Visible",
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
