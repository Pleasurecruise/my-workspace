# Debug builds load .env from the workspace root; release credentials use the OS store.
# Uncomment only the overrides you use. Empty or partial credential groups are invalid.
# Overrides take precedence over values saved in Settings (SQLite in debug builds).

# Consumer APIs
# MEMOS_API_KEY=your-memos-api-key
# MOMENT_API_KEY=your-moment-api-key
# KNOWLEDGE_API_KEY=your-knowledge-api-key

# R2: set both values together.
# R2_ACCESS_KEY_ID=your-r2-access-key-id
# R2_SECRET_ACCESS_KEY=your-r2-secret-access-key

# UGOS: set both values together; the server endpoint is fixed application policy.
# UGOS_USERNAME=your-ugos-username
# UGOS_PASSWORD=your-ugos-password

# Notifications and local app access
# NTFY_TOKEN=your-ntfy-read-token
# APP_LOCK_PASSWORD=your-app-lock-password

# Steam: set both values together.
# STEAM_ID=your-17-digit-steamid64
# STEAM_API_KEY=your-steam-web-api-key

# Telegram publication: set all three values together.
# TELEGRAM_API_ID=123456
# TELEGRAM_API_HASH=your-telegram-api-hash
# TELEGRAM_CHANNEL_USERNAME=your-channel-username

# Notion calendar: run `ntn login`, then configure the view link in Settings
# or with `vesper todo notion connect <view-url>`. No .env override exists.
# CherryIN reads the existing Cherry Studio session; no Vesper OAuth setup or .env key.
# ICS files remain in the directory printed by `vesper todo schedule-path`.
# ORM storage uses the application data directory; no database URL is required.
