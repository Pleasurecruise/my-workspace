# Uncomment only the development credentials that are actually used.
# Empty values are invalid and never fall back silently.
# UGOS_USERNAME=your-ugos-username
# UGOS_PASSWORD=your-ugos-password
# R2_ACCESS_KEY_ID=your-r2-access-key-id
# R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# MEMOS_API_KEY=your-memos-api-key
# MOMENT_API_KEY=your-moment-api-key
# KNOWLEDGE_API_KEY=your-knowledge-api-key
